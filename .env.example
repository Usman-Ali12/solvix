# Contact form email delivery (Resend — https://resend.com)
# 1. Create a free Resend account.
# 2. Verify a sending domain (or use their shared onboarding domain for testing).
# 3. Create an API key and paste it below.
RESEND_API_KEY=

# Where contact form submissions should land.
CONTACT_TO_EMAIL=info@solvixsolutions.com

# Must be an address on a domain verified in Resend, e.g. "Solvix <hello@usehallmark.com>"
CONTACT_FROM_EMAIL=hello@usehallmark.com

# Auth & accounts (Supabase — https://supabase.com)
# 1. Create a free Supabase project.
# 2. Project Settings → API → copy the Project URL and the "anon public" key below.
# 3. Run supabase/schema.sql once in the Supabase SQL editor to create the
#    profiles table, its policies, and the auto-provisioning trigger.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
